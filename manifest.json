{
  "manifest_version": 3,
  "name": "Send to SparkReceipt",
  "version": "2.4.0",
  "description": "One click grabs this page or image as a receipt file and drops it into SparkReceipt for you.",
  "permissions": ["activeTab", "downloads", "storage", "contextMenus", "debugger"],
  "host_permissions": ["https://app.sparkreceipt.com/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.sparkreceipt.com/*"],
      "js": ["sparkdrop.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to SparkReceipt",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "send-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Send this page to SparkReceipt"
    }
  }
}
